# ─────────────────────────────────────────────────────────────────────────────
# KisanGuard AI environment configuration — copy to config/.env and fill in values
#   cp config/.env.example config/.env
# config/.env is git-ignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=81911152b71c6e432f4b308711ac15ee4dcc029ef32c2f07e4c3d7e48d31db98
LOG_LEVEL=INFO

# ── Backend / frontend URLs (used for CORS + Streamlit -> API calls) ───────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000      # docker-compose: http://backend:8000
FRONTEND_URL=http://localhost:8501

# ── ML model & data paths ───────────────────────────────────────────────────
AGRIGUARD_PRICE_DATA=data/raw/agmarknet_prices_india.csv
MODEL_DIR=ml/models

# ── Weather (optional — Open-Meteo needs no API key; leave unset) ──────────
WEATHER_PROVIDER=open-meteo

# ── Database (optional — defaults to local SQLite if unset) ────────────────
DATABASE_URL=sqlite:///./kisanguard_dev.db

# ── AGMARKNET / data.gov.in (Indian commodity prices) ──────────────────────
AGMARKNET_API_KEY=

# ── Bhashini (multilingual voice — optional, text works without it) ────────
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# ── WhatsApp Business API (optional — only needed for real WhatsApp
#    gateway, not the /whatsapp/simulate endpoint used for local testing) ────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
